# Keep unset/false for review. Set the approved public origin and true only at launch.
NEXT_PUBLIC_SITE_ORIGIN=
NEXT_PUBLIC_SITE_INDEXABLE=false

# Confirmed LiveWell dashboard sign-in URL only; no credentials, tokens, query or hash.
# Production: https://<approved-dashboard-host>/login
# Local `pnpm dev` may use http://localhost:3001/login for the existing dashboard.
NEXT_PUBLIC_DASHBOARD_LOGIN_URL=
